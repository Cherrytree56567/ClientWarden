                          Fill="{ThemeResource ControlStrokeColorDefaultBrush}"
                          Stretch="Uniform" 
                          HorizontalAlignment="Stretch" 
                          VerticalAlignment="Bottom"
                          Margin="0, -20, -20, -10"
                          x:Name="SelectItemPath"/>
                    <ScrollViewer Padding="64, 36, 64, 16"
                                  VerticalScrollBarVisibility="Auto"
                                  Visibility="Collapsed"
                                  x:Name="SelectItem">
                        <StackPanel Orientation="Vertical">
                            <CommandBar IsOpen="False"
                                        DefaultLabelPosition="Right"
                                        Margin="0, 0, 0, 0"
                                        IsDynamicOverflowEnabled="False">
                                <AppBarButton Label="Edit"
                                              Click="SidebarEdit_Click"
                                              x:Name="EditButton">
                                    <AppBarButton.Icon>
                                        <BitmapIcon UriSource="ms-appx:///Assets/ic_fluent_edit_24_regular.png"
                                                    ShowAsMonochrome="True"/>
                                    </AppBarButton.Icon>
                                </AppBarButton>
                                <AppBarButton Label="Duplicate"
                                              Click="Duplicate_Click"
                                              x:Name="DuplicateButton">
                                    <AppBarButton.Icon>
                                        <BitmapIcon UriSource="ms-appx:///Assets/ic_fluent_document_copy_24_regular.png"
                                                    ShowAsMonochrome="True"/>
                                    </AppBarButton.Icon>
                                </AppBarButton>
                                <AppBarButton Label="Delete"
                                              Visibility="Collapsed"
                                              Click="Perm_Click"
                                              x:Name="PermButton">
                                    <AppBarButton.Icon>
                                        <BitmapIcon UriSource="ms-appx:///Assets/ic_fluent_delete_24_regular.png"
                                                    ShowAsMonochrome="True"/>
                                    </AppBarButton.Icon>
                                </AppBarButton>
                                <AppBarButton Label="Restore"
                                              Visibility="Collapsed"
                                              Click="Restore_Click"
                                              x:Name="RestoreButton">
                                    <AppBarButton.Icon>
                                        <BitmapIcon UriSource="ms-appx:///Assets/ic_fluent_arrow_reset_24_regular.png"
                                                    ShowAsMonochrome="True"/>
                                    </AppBarButton.Icon>
                                </AppBarButton>
                                <AppBarButton Label="Bin"
                                              Click="Delete_Click"
                                              x:Name="DeleteButton">
                                    <AppBarButton.Icon>
                                        <BitmapIcon UriSource="ms-appx:///Assets/ic_fluent_delete_24_regular.png"
                                                    ShowAsMonochrome="True"/>
                                    </AppBarButton.Icon>
                                </AppBarButton>
                                <AppBarButton Label="Save"
                                              Visibility="Collapsed"
                                              Click="SidebarSave_Click"
                                              x:Name="SaveButton">
                                    <AppBarButton.Icon>
                                        <BitmapIcon UriSource="ms-appx:///Assets/ic_fluent_save_24_regular.png"
                                                    ShowAsMonochrome="True"/>
                                    </AppBarButton.Icon>
                                </AppBarButton>
                                <AppBarButton Label="Cancel"
                                              Visibility="Collapsed"
                                              Click="SidebarCancel_Click"
                                              x:Name="CancelButton">
                                    <AppBarButton.Icon>
                                        <BitmapIcon UriSource="ms-appx:///Assets/ic_fluent_subtract_circle_24_regular.png"
                                                    ShowAsMonochrome="True"/>
                                    </AppBarButton.Icon>
                                </AppBarButton>
                            </CommandBar>
                            <Grid Margin="0, 16, 0, 0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border CornerRadius="4"
                                        Grid.Column="0">
                                    <Image Source="ms-appx:///Assets/profile1.png"
                                        Width="42"
                                        x:Name="SidebarImage"/>
                                </Border>
                                <StackPanel Orientation="Vertical"
                                            Margin="12, 0, 0, 0"
                                            Grid.Column="1">
                                    <TextBlock Text="Test Website"
                                             FontWeight="Bold"
                                             FontSize="24"
                                             x:Name="SidebarTitle"/>
                                    <TextBox Text="Test Website"
                                             FontWeight="Bold"
                                             FontSize="24"
                                             Visibility="Collapsed"
                                             x:Name="SidebarTitleBox"/>
                                    <TextBlock Text="Login"
                                               FontSize="10"
                                               VerticalAlignment="Bottom"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               x:Name="SidebarType"/>
                                    <TextBlock x:Name="SidebarId" 
                                               Visibility="Collapsed"/>
                                </StackPanel>
                                <Grid HorizontalAlignment="Right"
                                    Grid.Column="2">
                                    <BitmapIcon UriSource="ms-appx:///Assets/ic_fluent_star_24_regular.png"
                                                ShowAsMonochrome="True"
                                                Width="20"
                                                x:Name="SidebarFav"
                                                Tapped="Favorite_Click"/>
                                </Grid>
                            </Grid>
                            <local:FolderEditField Title="Folder" x:Name="FolderPicker"/>
                            <Border BorderThickness="0, 0, 0, 1"
                                    Padding="0, 16, 0, 0"
                                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"/>
                            <StackPanel x:Name="SidebarCard">
                            </StackPanel>
                            
                            <Border BorderThickness="0, 0, 0, 1"
                                    Padding="0, 8, 0, 0"
                                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"/>
                            <UserControl Margin="0, 8, 0, 0">
                                <Border Padding="10, 8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="2" x:Name="SidebarNotesParent">
                                            <TextBlock Text="Notes" 
                                                       FontSize="11"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       Padding="0, 0, 0, 4"/>
                                            <TextBlock TextWrapping="WrapWholeWords" 
                                                       Text=""
                                                       FontSize="14"
                                                       x:Name="SidebarNotes"/>
                                            <TextBox TextWrapping="Wrap" 
                                                     Text=""
                                                     FontSize="14"
                                                     Visibility="Collapsed"
                                                     x:Name="SidebarNotesEdit"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </UserControl>
                            <Border BorderThickness="0, 0, 0, 1"
                                    Padding="0, 8, 0, 0"
                                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"/>
                            <Button x:Name="AddButton"
                                    Width="24"
                                    Height="24"
                                    Padding="0"
                                    Margin="0, 6, 0, 0"
                                    HorizontalAlignment="Right">
                                <Button.Flyout>
                                    <Flyout>
                                        <StackPanel>
                                            <ComboBox x:Name="FieldsDropdown" SelectionChanged="FieldsDropdown_SelectionChanged">
                                                <ComboBoxItem Content="Text"/>
                                                <ComboBoxItem Content="Hidden"/>
                                                <ComboBoxItem Content="Checkbox"/>
                                                <ComboBoxItem Content="Linked"/>
                                            </ComboBox>
                                        </StackPanel>
                                    </Flyout>
                                </Button.Flyout>
                                <FontIcon Glyph="&#xE710;" FontSize="12"/>
                            </Button>
                            <StackPanel x:Name="SidebarFields">
                            </StackPanel>
                            <Border BorderThickness="0, 0, 0, 1"
                                    Padding="0, 8, 0, 0"
                                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"/>
                            <Button x:Name="AddAttachmentButton"
                                    Width="24"
                                    Height="24"
                                    Padding="0"
                                    Margin="0, 6, 0, 0"
                                    HorizontalAlignment="Right"
                                    Click="SidebarAttachment_Click">
                                <FontIcon Glyph="&#xE898;" FontSize="12"/>
                            </Button>
                            <StackPanel x:Name="SidebarAttachments" Orientation="Vertical">
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </NavigationView>
        <TeachingTip x:Name="CopyTip"
                     Title="Copied to clipboard!"
                     IsLightDismissEnabled="True"
                     PlacementMargin="20"
                     PreferredPlacement="Auto"
                     IsOpen="false"/>
    </Grid>
</Page>
