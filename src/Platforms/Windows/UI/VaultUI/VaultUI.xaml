<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WindowsUI.VaultUI"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WindowsUI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <NavigationView Grid.Column="0"
                        PaneDisplayMode="Left"
                        IsBackButtonVisible="Collapsed"
                        IsPaneToggleButtonVisible="True"
                        OpenPaneLength="220"
                        x:Name="NavView"
                        PaneTitle="Clientwarden"
                        Loaded="NavigationView_Loaded"
                        SelectionChanged="NavigationView_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="All Items" x:Name="AllItems">
                    <NavigationViewItem.Icon>
                        <BitmapIcon UriSource="ms-appx:///Assets/Logo.png"
                                    ShowAsMonochrome="True"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Favorites" x:Name="Fav">
                    <NavigationViewItem.Icon>
                        <BitmapIcon UriSource="ms-appx:///Assets/ic_fluent_star_24_regular.png"
                                    ShowAsMonochrome="True"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Trash" x:Name="Del">
                    <NavigationViewItem.Icon>
                        <BitmapIcon UriSource="ms-appx:///Assets/ic_fluent_delete_24_regular.png"
                                    ShowAsMonochrome="True"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItemSeparator/>

                <NavigationViewItemHeader Content="Types"/>
                <NavigationViewItem Content="Login" x:Name="Login">
                    <NavigationViewItem.Icon>
                        <BitmapIcon UriSource="ms-appx:///Assets/ic_fluent_globe_24_filled.png"
                                    ShowAsMonochrome="True"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Card" x:Name="Card">
                    <NavigationViewItem.Icon>
                        <BitmapIcon UriSource="ms-appx:///Assets/ic_fluent_credit_card_person_24_regular.png"
                                    ShowAsMonochrome="True"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Identity" x:Name="Identity">
                    <NavigationViewItem.Icon>
                        <BitmapIcon UriSource="ms-appx:///Assets/ic_fluent_contact_card_24_regular.png"
                                    ShowAsMonochrome="True"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Secure Note" x:Name="SecNote">
                    <NavigationViewItem.Icon>
                        <BitmapIcon UriSource="ms-appx:///Assets/ic_fluent_note_24_regular.png"
                                    ShowAsMonochrome="True"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="SSH Key" x:Name="SSH">
                    <NavigationViewItem.Icon>
                        <BitmapIcon UriSource="ms-appx:///Assets/ic_fluent_key_24_regular.png"
                                    ShowAsMonochrome="True"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItemSeparator/>

                <NavigationViewItemHeader Content="Folders"/>
            </NavigationView.MenuItems>

            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="New Folder" Icon="Add" x:Name="NewFold"/>
            </NavigationView.FooterMenuItems>
            <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
                  Grid.Column="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <Border BorderThickness="1, 0, 1, 0"
                            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid VerticalAlignment="Top"
                                  Margin="12"
                                  Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <AutoSuggestBox Grid.Column="0"
                                                QueryIcon="Find"
                                                PlaceholderText="Search"
                                                x:Name="SearchBar"
                                                TextChanged="SearchBox_TextChanged"/>
                
                                <Button Grid.Column="1"
                                        VerticalAlignment="Stretch"
                                        Margin="12, 0, 0, 0"
                                        Style="{ThemeResource AccentButtonStyle}">
                                        <Button.Flyout>
                                            <Flyout>
                                                <StackPanel>
                                                    <ComboBox x:Name="NewItemDropdown" SelectionChanged="NewItemDropdown_SelectionChanged">
                                                        <ComboBoxItem Content="Login"/>
                                                        <ComboBoxItem Content="Card"/>
                                                        <ComboBoxItem Content="Identity"/>
                                                        <ComboBoxItem Content="SSH Key"/>
                                                        <ComboBoxItem Content="Note"/>
                                                    </ComboBox>
                                                </StackPanel>
                                            </Flyout>
                                        </Button.Flyout>
                                    <FontIcon Glyph="&#xE710;" FontSize="16"/>
                                </Button>
                            </Grid>
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          Grid.Row="1">
                                <StackPanel x:Name="VaultItemList">
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>

                <ScrollViewer Grid.Column="1"
                              Padding="64, 36, 64, 16"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel Orientation="Vertical">
                        <CommandBar IsOpen="False"
                                    DefaultLabelPosition="Right"
                                    Margin="0, 0, -12, 0">
                            <AppBarButton Label="Edit"
                                          Click="SidebarEdit_Click"
                                          x:Name="EditButton">
                                <AppBarButton.Icon>
                                    <BitmapIcon UriSource="ms-appx:///Assets/ic_fluent_edit_24_regular.png"
                                                ShowAsMonochrome="True"/>
                                </AppBarButton.Icon>
                            </AppBarButton>
                            <AppBarButton Label="Duplicate"
                                          Click="Duplicate_Click"
                                          x:Name="DuplicateButton">
                                <AppBarButton.Icon>
                                    <BitmapIcon UriSource="ms-appx:///Assets/ic_fluent_document_copy_24_regular.png"
                                                ShowAsMonochrome="True"/>
                                </AppBarButton.Icon>
                            </AppBarButton>
                            <AppBarButton Label="Delete"
                                          Click="Delete_Click"
                                          x:Name="DeleteButton">
                                <AppBarButton.Icon>
                                    <BitmapIcon UriSource="ms-appx:///Assets/ic_fluent_delete_24_regular.png"
                                                ShowAsMonochrome="True"/>
                                </AppBarButton.Icon>
                            </AppBarButton>
                            <AppBarButton Label="Save"
                                          Visibility="Collapsed"
                                          Click="SidebarSave_Click"
                                          x:Name="SaveButton">
                                <AppBarButton.Icon>
                                    <BitmapIcon UriSource="ms-appx:///Assets/ic_fluent_save_24_regular.png"
                                                ShowAsMonochrome="True"/>
                                </AppBarButton.Icon>
                            </AppBarButton>
                            <AppBarButton Label="Cancel"
                                          Visibility="Collapsed"
                                          Click="SidebarCancel_Click"
                                          x:Name="CancelButton">
                                <AppBarButton.Icon>
                                    <BitmapIcon UriSource="ms-appx:///Assets/ic_fluent_subtract_circle_24_regular.png"
                                                ShowAsMonochrome="True"/>
                                </AppBarButton.Icon>
                            </AppBarButton>
                        </CommandBar>
                        <Grid Margin="0, 16, 0, 0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border CornerRadius="4"
                                    Grid.Column="0">
                                <Image Source="ms-appx:///Assets/profile1.png"
                                       Width="42"
                                       x:Name="SidebarImage"/>
                            </Border>
                            <StackPanel Orientation="Vertical"
                                        Margin="12, 0, 0, 0"
                                        Grid.Column="1">
                                <TextBlock Text="Test Website"
                                           FontWeight="Bold"
                                           FontSize="24"
                                           x:Name="SidebarTitle"/>
                                <TextBox Text="Test Website"
                                         FontWeight="Bold"
                                         FontSize="24"
                                         Visibility="Collapsed"
                                         x:Name="SidebarTitleBox"/>
                                <TextBlock Text="Login"
                                           FontSize="10"
                                           VerticalAlignment="Bottom"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           x:Name="SidebarType"/>
                                <TextBlock x:Name="SidebarId" 
                                           Visibility="Collapsed"/>
                            </StackPanel>
                            <Grid HorizontalAlignment="Right"
                                  Grid.Column="2">
                                <BitmapIcon UriSource="ms-appx:///Assets/ic_fluent_star_24_regular.png"
                                            ShowAsMonochrome="True"
                                            Width="20"
                                            x:Name="SidebarFav"
                                            Tapped="Favorite_Click"/>
                            </Grid>
                        </Grid>
                        <local:FolderEditField Title="Folder" x:Name="FolderPicker"/>
                        <Border BorderThickness="0, 0, 0, 1"
                                Padding="0, 16, 0, 0"
                                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"/>
                        <StackPanel x:Name="SidebarCard">
                        </StackPanel>
                        
                        <Border BorderThickness="0, 0, 0, 1"
                                Padding="0, 8, 0, 0"
                                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"/>
                        <UserControl Margin="0, 8, 0, 0">
                            <Border Padding="10, 8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="2" x:Name="SidebarNotesParent">
                                        <TextBlock Text="Notes" 
                                                   FontSize="11"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   Padding="0, 0, 0, 4"/>
                                        <TextBlock TextWrapping="WrapWholeWords" 
                                                   Text=""
                                                   FontSize="14"
                                                   x:Name="SidebarNotes"/>
                                        <TextBox TextWrapping="Wrap" 
                                                 Text=""
                                                 FontSize="14"
                                                 Visibility="Collapsed"
                                                 x:Name="SidebarNotesEdit"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </UserControl>
                        <Border BorderThickness="0, 0, 0, 1"
                                Padding="0, 8, 0, 0"
                                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"/>
                        <Button x:Name="AddButton"
                                Width="24"
                                Height="24"
                                Padding="0"
                                Margin="0, 6, 0, 0"
                                HorizontalAlignment="Right"
                                Visibility="Collapsed">
                            <Button.Flyout>
                                <Flyout>
                                    <StackPanel>
                                        <ComboBox x:Name="FieldsDropdown" SelectionChanged="FieldsDropdown_SelectionChanged">
                                            <ComboBoxItem Content="Text"/>
                                            <ComboBoxItem Content="Hidden"/>
                                            <ComboBoxItem Content="Checkbox"/>
                                            <ComboBoxItem Content="Linked"/>
                                        </ComboBox>
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                            <FontIcon Glyph="&#xE710;" FontSize="12"/>
                        </Button>
                        <StackPanel x:Name="SidebarFields">
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </NavigationView>
        <TeachingTip x:Name="CopyTip"
                     Title="Copied to clipboard!"
                     IsLightDismissEnabled="True"
                     PlacementMargin="20"
                     PreferredPlacement="Auto"
                     IsOpen="false"/>
    </Grid>
</Page>
